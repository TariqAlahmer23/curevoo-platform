PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/curevoo?schema=public"
JWT_ACCESS_SECRET="access_secret_change_me"
JWT_REFRESH_SECRET="refresh_secret_change_me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
AI_RASA_BASE_URL="http://127.0.0.1:5005"
AI_NSCLC_BASE_URL="http://127.0.0.1:8002"

# Genomic target prioritization FastAPI service (dip-ai-service).
# AI_SERVICE_URL is honoured as a fallback for AI_GENOMIC_TARGETS_BASE_URL.
AI_GENOMIC_TARGETS_BASE_URL="http://127.0.0.1:8001"
AI_SERVICE_URL="http://127.0.0.1:8001"
AI_GENOMIC_MAX_UPLOAD_BYTES="104857600"
AI_GENOMIC_HEALTH_TIMEOUT_MS="8000"
AI_GENOMIC_ANALYZE_TIMEOUT_MS="180000"
AI_GENOMIC_RESULTS_TIMEOUT_MS="20000"

# Security hardening
TRUST_PROXY="0"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
REFRESH_COOKIE_SAMESITE="strict"
UPLOAD_SIGNING_SECRET="change_me_upload_signing_secret"
OTP_MAX_ATTEMPTS="5"
OTP_LOCK_MINUTES="15"
RATE_LIMIT_LOGIN_WINDOW_MS="600000"
RATE_LIMIT_LOGIN_MAX="8"
RATE_LIMIT_LOGIN_BLOCK_MS="900000"
RATE_LIMIT_REFRESH_WINDOW_MS="300000"
RATE_LIMIT_REFRESH_MAX="20"
RATE_LIMIT_REFRESH_BLOCK_MS="600000"
RATE_LIMIT_OTP_SEND_WINDOW_MS="600000"
RATE_LIMIT_OTP_SEND_MAX="5"
RATE_LIMIT_OTP_SEND_BLOCK_MS="900000"
RATE_LIMIT_OTP_VERIFY_WINDOW_MS="600000"
RATE_LIMIT_OTP_VERIFY_MAX="10"
RATE_LIMIT_OTP_VERIFY_BLOCK_MS="900000"
